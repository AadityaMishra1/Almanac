# Root environment file - copy to .env and fill in your values
# For detailed configuration, see backend/.env.example and frontend/.env.example

# Quick setup for development
DATABASE_URL=postgresql://user:password@localhost:5432/ai_calendar
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your_super_secret_jwt_key_change_this
